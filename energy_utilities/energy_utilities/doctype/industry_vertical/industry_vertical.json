     "in_list_view": 1},
    {"fieldname": "default_uom", "fieldtype": "Link", "options": "UOM", "label": "Default Measurement UOM"},
    {"fieldname": "default_currency", "fieldtype": "Link", "options": "Currency"},
    {"fieldname": "icon", "fieldtype": "Data", "label": "FontAwesome Icon"},
    {"fieldname": "color", "fieldtype": "Color"},
    {"fieldname": "active", "fieldtype": "Check", "default": 1, "in_list_view": 1},
    {"fieldname": "description", "fieldtype": "Small Text"}
