{
  "doctype": "DocType",
  "name": "Consumer Connection",
  "module": "Energy Utilities",
  "autoname": "naming_series:",
  "fields": [
    {"fieldname": "naming_series", "fieldtype": "Select", "options": "CON-.YYYY.-"},
